{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-item.schema.json",
  "title": "AI Lab concrete catalog item metadata",
  "allOf": [
    { "$ref": "./default.schema.json" },
    {
      "type": "object",
      "properties": {
        "node": {
          "properties": {
            "local": {
              "properties": {
                "entity": { "$ref": "./default.schema.json#/$defs/entity" },
                "relations": {
                  "type": "array",
                  "items": { "$ref": "./default.schema.json#/$defs/relation" }
                },
                "resources": {
                  "type": "array",
                  "items": { "$ref": "./default.schema.json#/$defs/resource" }
                },
                "dependencies": { "type": "array" },
                "facts": { "type": "object" }
              }
            }
          }
        }
      }
    }
  ]
}
