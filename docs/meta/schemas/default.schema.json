{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "default.schema.json",
  "title": "Default documentation metadata",
  "description": "Base schema and reusable definitions for default-locale documentation-node metadata.",
  "$defs": {
    "metadata_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "type": "object" }
      }
    },
    "schema_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "relative_markdown_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
    },
    "locale_id": {
      "type": "string",
      "pattern": "^[a-z]{2}_[A-Z]{2}$"
    },
    "source_hash": {
      "type": "string",
      "oneOf": [
        { "pattern": "^sha256:[0-9a-f]{64}$" },
        { "pattern": "^gitblob:[0-9a-f]{40}$" }
      ]
    },
    "parameter_remove_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "before": { "type": "boolean" },
        "after": { "type": "boolean" },
        "prune": { "type": "boolean" }
      }
    },
    "parameter_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "key"],
      "properties": {
        "op": { "enum": ["set", "remove"] },
        "key": { "type": "string", "minLength": 1 },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "op": { "const": "set" } },
            "required": ["op"]
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": { "op": { "const": "remove" } },
            "required": ["op"]
          },
          "then": {
            "not": { "required": ["value"] }
          }
        }
      ]
    },
    "parameter_operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter_operation" }
        },
        "local": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter_operation" }
        },
        "after": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter_operation" }
        }
      },
      "minProperties": 1
    },
    "parameter_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": { "type": "object" },
        "remove": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/parameter_remove_rule" }
            }
          ]
        },
        "local": { "type": "object" },
        "operations": { "$ref": "#/$defs/parameter_operations" }
      },
      "minProperties": 1
    },
    "layout_config": {
      "oneOf": [
        { "$ref": "#/$defs/registry_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/registry_id" },
            "parameters": { "$ref": "#/$defs/parameter_envelope" }
          }
        }
      ]
    },
    "template_config": {
      "oneOf": [
        { "$ref": "#/$defs/registry_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/registry_id" },
            "layout": { "$ref": "#/$defs/layout_config" },
            "parameters": { "$ref": "#/$defs/parameter_envelope" }
          },
          "minProperties": 1
        }
      ]
    },
    "requirements_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_markdown_path" }
      }
    },
    "local_context": {
      "type": "object",
      "properties": {
        "favorites": { "type": "boolean" }
      },
      "additionalProperties": true,
      "minProperties": 1
    },
    "reset_config": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": true,
          "minProperties": 1
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "scope", "url"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["official", "reference", "community"] },
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "default_localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "$ref": "#/$defs/schema_id" },
        "disabled": { "const": true }
      },
      "minProperties": 1
    },
    "node_common": {
      "type": "object",
      "properties": {
        "schema": { "$ref": "#/$defs/schema_id" },
        "requirements": { "$ref": "#/$defs/requirements_config" },
        "template": { "$ref": "#/$defs/template_config" },
        "local": { "$ref": "#/$defs/local_context" },
        "reset": { "$ref": "#/$defs/reset_config" },
        "entity": { "$ref": "#/$defs/entity" },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        },
        "dependencies": { "type": "array" },
        "facts": { "type": "object" }
      }
    },
    "default_node_open": {
      "allOf": [
        { "$ref": "#/$defs/node_common" },
        {
          "type": "object",
          "properties": {
            "children": { "$ref": "#/$defs/default_node" },
            "localization": { "$ref": "#/$defs/default_localization" }
          }
        }
      ]
    },
    "default_node": {
      "allOf": [
        { "$ref": "#/$defs/default_node_open" }
      ],
      "unevaluatedProperties": false,
      "minProperties": 1
    }
  },
  "allOf": [
    { "$ref": "#/$defs/metadata_document" },
    {
      "type": "object",
      "properties": {
        "node": { "$ref": "#/$defs/default_node" }
      }
    }
  ]
}
