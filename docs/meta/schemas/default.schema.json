{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AGvin/ai-lab/docs/meta/schemas/default.schema.json",
  "title": "AI Lab documentation node extension",
  "type": "object",
  "properties": {
    "entity": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "kind"],
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "role": { "type": "string" }
        },
        "required": ["type", "target"],
        "additionalProperties": true
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["official", "reference", "community"] },
          "url": { "type": "string", "format": "uri" },
          "label": { "type": "string" }
        },
        "required": ["type", "scope", "url"],
        "additionalProperties": true
      }
    },
    "dependencies": { "type": "array" },
    "facts": { "type": "object" }
  },
  "additionalProperties": true
}
