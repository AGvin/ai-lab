{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "producer.schema.json",
  "title": "AI Lab canonical producer metadata",
  "allOf": [
    { "$ref": "./default.schema.json" },
    {
      "type": "object",
      "properties": {
        "node": {
          "required": ["local"],
          "properties": {
            "local": {
              "required": ["entity"],
              "properties": {
                "entity": {
                  "properties": {
                    "kind": { "const": "producer" }
                  },
                  "required": ["id", "kind"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
