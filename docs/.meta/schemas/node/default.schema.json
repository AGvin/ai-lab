{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "default",
  "title": "Default documentation node metadata",
  "description": "Base structural contract for default-locale documentation-node metadata.",
  "$defs": {
    "schema_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "locale_id": {
      "type": "string",
      "pattern": "^[a-z]{2}_[A-Z]{2}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "parameter_remove_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "before": {
          "type": "boolean"
        },
        "after": {
          "type": "boolean"
        },
        "prune": {
          "type": "boolean"
        }
      }
    },
    "parameter_operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "key": {
              "$ref": "#/$defs/non_empty_string"
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "key": {
              "$ref": "#/$defs/non_empty_string"
            },
            "prune": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "parameter_operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_operation"
          }
        },
        "local": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_operation"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_operation"
          }
        }
      },
      "minProperties": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object"
        },
        "remove": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/parameter_remove_rule"
              }
            }
          ]
        },
        "local": {
          "type": "object"
        },
        "operations": {
          "$ref": "#/$defs/parameter_operations"
        }
      },
      "minProperties": 1
    },
    "layout": {
      "oneOf": [
        {
          "$ref": "#/$defs/registry_id"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/registry_id"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "template": {
      "oneOf": [
        {
          "$ref": "#/$defs/registry_id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/registry_id"
            },
            "layout": {
              "$ref": "#/$defs/layout"
            },
            "parameters": {
              "$ref": "#/$defs/parameters"
            }
          },
          "minProperties": 1
        }
      ]
    },
    "reset_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "before": {
          "type": "boolean"
        },
        "after": {
          "type": "boolean"
        },
        "exclude_default_matches": {
          "type": "boolean"
        }
      }
    },
    "reset": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reset_rule"
          }
        }
      ]
    },
    "local": {
      "type": "object",
      "properties": {
        "local": false,
        "favorites": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/$defs/string_list"
        }
      },
      "additionalProperties": true,
      "minProperties": 1
    },
    "child_local": {
      "type": "object",
      "properties": {
        "local": false,
        "favorites": false,
        "labels": {
          "$ref": "#/$defs/string_list"
        }
      },
      "additionalProperties": true,
      "minProperties": 1
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_id"
        },
        "disabled": {
          "type": "boolean"
        },
        "default_locale": {
          "$ref": "#/$defs/locale_id"
        },
        "locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale_id"
          },
          "uniqueItems": true
        }
      },
      "minProperties": 1
    },
    "children": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_id"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "template": {
          "$ref": "#/$defs/template"
        },
        "children": {
          "$ref": "#/$defs/children"
        },
        "local": {
          "$ref": "#/$defs/child_local"
        },
        "reset": {
          "$ref": "#/$defs/reset"
        },
        "localization": {
          "$ref": "#/$defs/localization"
        }
      },
      "minProperties": 1
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_id"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "template": {
          "$ref": "#/$defs/template"
        },
        "children": {
          "$ref": "#/$defs/children"
        },
        "local": {
          "$ref": "#/$defs/local"
        },
        "reset": {
          "$ref": "#/$defs/reset"
        },
        "localization": {
          "$ref": "#/$defs/localization"
        }
      },
      "minProperties": 1
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "properties": {
    "node": {
      "$ref": "#/$defs/node"
    }
  }
}
